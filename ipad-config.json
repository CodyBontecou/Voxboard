      "headlineSize": 140,
      "subtitleSize": 46,
      "phoneWidth": 1650,
      "phoneTop": 680,
      "textTop": 80,
      "css": "#slide-1 .phone-body { border-radius: 36px; padding: 8px; } #slide-1 .phone-screen { border-radius: 28px; } #slide-1 .btn-silence { display: none; }"
    },
    {
      "layout": "text-bottom",
