{
  "theme": {
    "accentColor": "#F28C38",
    "font": "JetBrains Mono",
    "fontUrl": "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap",
    "backgroundColor": "#000000",
    "textColor": "#f5f5f7",
    "subtitleColor": "#86868b",
    "frameColor": "dark"
