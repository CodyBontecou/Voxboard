{
  "$defs": {
    "deferred": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        },
        "requiredBeforeMilestone": {
          "pattern": "^M(?:[0-9]|10)$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "requiredBeforeMilestone",
        "reason"
      ],
      "type": "object"
    },
    "gate": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]+(?:-[a-z0-9_]+)*$",
          "type": "string"
        },
        "metric": {
          "enum": [
            "duration",
            "additionalRSS",
            "peakRSS",
            "chunkSize",
            "acceptedAggregateInput",
            "ratio",
            "batteryConsumption",
            "artifactSize",
            "growth"
          ]
        },
        "milestone": {
          "pattern": "^M(?:[0-9]|10)$",
          "type": "string"
        },
        "minimumSamples": {
          "maximum": 1000000,
          "minimum": 1,
          "type": "integer"
        },
        "operator": {
          "enum": [
            "lessThanOrEqual",
            "greaterThanOrEqual"
          ]
        },
        "requiredSampleValues": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "samplingMethod": {
          "minLength": 20,
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "type": "string"
        },
        "statistic": {
          "enum": [
            "p95",
            "maximum",
            "minimum"
          ]
        },
        "unit": {
          "enum": [
            "ms",
            "s",
            "bytes",
            "ratio",
            "percent"
          ]
        },
        "value": {
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "id",
        "milestone",
        "metric",
        "statistic",
        "operator",
        "value",
        "unit",
        "minimumSamples",
        "samplingMethod"
      ],
      "type": "object"
    },
    "packagingBaselinePolicy": {
      "additionalProperties": false,
      "properties": {
        "futureGrowthRule": {
          "minLength": 80,
          "type": "string"
        },
        "growthAppliesWhen": {
          "const": "approvedBaselineComparison"
        },
        "id": {
          "const": "m2-first-core-packaging-baseline-v1"
        },
        "initializationMode": {
          "const": "absoluteFirstCoreThenApprovedBaseline"
        },
        "initializationRule": {
          "minLength": 80,
          "type": "string"
        },
        "milestone": {
          "const": "M2"
        },
        "required": {
          "const": true
        },
        "requiredHashFields": {
          "const": [
            "candidateArtifactSha256"
          ]
        },
        "requiredIdentityFields": {
          "const": [
            "gateID",
            "candidateRevision",
            "toolchainID",
            "targetScope",
            "buildConfiguration",
            "featureSet",
            "artifactID"
          ]
        },
        "requiredLeafScopes": {
          "items": {
            "$ref": "#/$defs/packagingLeafScope"
          },
          "maxItems": 6,
          "minItems": 6,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "required",
        "milestone",
        "initializationMode",
        "initializationRule",
        "futureGrowthRule",
        "growthAppliesWhen",
        "requiredIdentityFields",
        "requiredHashFields",
        "requiredLeafScopes"
      ],
      "type": "object"
    },
    "packagingLeafScope": {
      "additionalProperties": false,
      "properties": {
        "gateID": {
          "enum": [
            "android-core-arm64-uncompressed",
            "android-core-armv7-uncompressed",
            "android-core-x86_64-uncompressed",
            "android-core-x86-uncompressed",
            "apple-xcframework-per-slice"
          ]
        },
        "targetScope": {
          "enum": [
            "arm64-v8a",
            "armeabi-v7a",
            "x86_64",
            "x86",
            "xcframework-ios-device-arm64",
            "xcframework-ios-simulator-arm64-x86_64"
          ]
        }
      },
      "required": [
        "gateID",
        "targetScope"
      ],
      "type": "object"
    }
  },
  "$id": "https://vox.md/contracts/schemas/performance-gates.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "../schemas/performance-gates.schema.json"
    },
    "deferredRequiredBudgets": {
      "items": {
        "$ref": "#/$defs/deferred"
      },
      "maxItems": 32,
      "type": "array"
    },
    "gateSetID": {
      "minLength": 1,
      "type": "string"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/gate"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "packagingBaselinePolicy": {
      "$ref": "#/$defs/packagingBaselinePolicy"
    },
    "schemaVersion": {
      "const": 2
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "gateSetID",
    "gates",
    "deferredRequiredBudgets",
    "packagingBaselinePolicy"
  ],
  "title": "Performance gate definitions",
  "type": "object"
}
