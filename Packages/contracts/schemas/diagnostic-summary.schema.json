{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vox.md/contracts/schemas/diagnostic-summary.schema.json",
  "title": "Privacy-safe validation diagnostic summary",
  "type": "object",
  "required": ["schemaVersion", "format", "kind", "resultCode", "checks", "referencedHashes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "format": {"const": "vox-validation-diagnostic-summary"},
    "kind": {"enum": ["fixture", "artifact"]},
    "resultCode": {"enum": ["passed", "failed", "blocked", "notRun", "notApplicable"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["code", "result", "count"],
        "additionalProperties": false,
        "properties": {
          "code": {"enum": ["durability", "integrity", "bounds", "privacyFormat", "providerReceipt", "wearAcknowledgement", "performanceGate", "swiftRustParity", "unsupportedVersionFailClosed", "bindingDrift", "readinessPins", "shadowSideEffects"]},
          "result": {"enum": ["passed", "failed", "blocked", "notRun", "notApplicable"]},
          "count": {"type": "integer", "minimum": 0, "maximum": 1000000}
        }
      }
    },
    "referencedHashes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["role", "sha256"],
        "additionalProperties": false,
        "properties": {
          "role": {"enum": ["fixture", "input", "output", "receipt", "build", "manifest"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
