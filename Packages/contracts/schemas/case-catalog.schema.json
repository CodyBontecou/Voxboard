{
  "$defs": {
    "case": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "CORE",
            "REC",
            "SAF",
            "WEAR",
            "PERF"
          ]
        },
        "deviceRoles": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "type": "array",
          "uniqueItems": true
        },
        "executionTarget": {
          "enum": [
            "buildHost",
            "artifactBuildHost",
            "physicalDevice"
          ]
        },
        "expected": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "pattern": "^(CORE|REC|SAF|WEAR|PERF)-[0-9]{3}$",
          "type": "string"
        },
        "invariants": {
          "items": {
            "pattern": "^INV-[A-Z0-9-]+$",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array",
          "uniqueItems": true
        },
        "milestone": {
          "pattern": "^M(?:[0-9]|10)$",
          "type": "string"
        },
        "performanceGateIDs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "providerApplicability": {
          "enum": [
            "none",
            "allRequired",
            "nonLocalRequired"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "category",
        "required",
        "milestone",
        "executionTarget",
        "deviceRoles",
        "providerApplicability",
        "invariants",
        "expected"
      ],
      "type": "object"
    }
  },
  "$id": "https://vox.md/contracts/schemas/case-catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "../schemas/case-catalog.schema.json"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/case"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "catalogID": {
      "minLength": 1,
      "type": "string"
    },
    "nonWaivableInvariants": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^INV-[A-Z0-9-]+$",
            "type": "string"
          },
          "text": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "type": "object"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": {
      "const": 2
    },
    "statusVocabulary": {
      "const": [
        "passed",
        "failed",
        "blocked",
        "notRun",
        "notApplicable"
      ]
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "catalogID",
    "statusVocabulary",
    "nonWaivableInvariants",
    "cases"
  ],
  "title": "Validation case catalog",
  "type": "object"
}
