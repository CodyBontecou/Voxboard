{
  "$id": "https://vox.md/contracts/schemas/case-evidence-requirements.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "../schemas/case-evidence-requirements.schema.json"
    },
    "buildHostRequiredFacts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "hostedRequiredFacts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "physicalDeviceRequiredFacts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "placeholderTokensRejected": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "policyID": {
      "minLength": 1,
      "type": "string"
    },
    "privacyForbiddenKinds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "recordSchema": {
      "const": "../schemas/case-evidence.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "statusVocabulary": {
      "const": [
        "passed",
        "failed",
        "blocked",
        "notRun",
        "notApplicable"
      ]
    },
    "typedReceiptRequirements": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "policyID",
    "recordSchema",
    "statusVocabulary",
    "buildHostRequiredFacts",
    "physicalDeviceRequiredFacts",
    "hostedRequiredFacts",
    "typedReceiptRequirements",
    "placeholderTokensRejected",
    "privacyForbiddenKinds"
  ],
  "title": "Conditional case evidence fact policy",
  "type": "object"
}
