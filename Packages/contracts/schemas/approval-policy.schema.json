{
  "$id": "https://vox.md/contracts/schemas/approval-policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "../schemas/approval-policy.schema.json"
    },
    "policyID": {
      "minLength": 1,
      "type": "string"
    },
    "qualificationRequirements": {
      "additionalProperties": false,
      "properties": {
        "hostedRun": {
          "const": []
        },
        "releaseGate": {
          "const": [
            "definition",
            "campaign",
            "releaseGate"
          ]
        },
        "repositoryObservation": {
          "const": []
        }
      },
      "required": [
        "repositoryObservation",
        "hostedRun",
        "releaseGate"
      ],
      "type": "object"
    },
    "recordSchema": {
      "const": "../schemas/approval.schema.json"
    },
    "rules": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": {
      "const": 2
    },
    "statuses": {
      "const": [
        "approved",
        "rejected",
        "pending",
        "expired"
      ]
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "policyID",
    "recordSchema",
    "qualificationRequirements",
    "statuses",
    "rules"
  ],
  "title": "Qualification-specific approval policy",
  "type": "object"
}
