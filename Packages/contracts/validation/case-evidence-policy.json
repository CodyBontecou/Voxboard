{
  "$schema": "../schemas/case-evidence-requirements.schema.json",
  "buildHostRequiredFacts": [
    "buildIdentity.sourceRevision",
    "buildIdentity.sourceTreeState",
    "buildIdentity.toolchainManifestSha256",
    "buildIdentity.buildRecipeSha256",
    "buildIdentity.executableSha256",
    "buildHost.osName",
    "buildHost.osVersion",
    "buildHost.architecture",
    "buildHost.cpuModel",
    "buildHost.logicalCPUCount",
    "buildHost.totalMemoryBytes"
  ],
  "hostedRequiredFacts": [
    "qualification.runID",
    "qualification.runAttempt",
    "qualification.workflowRepositoryPath",
    "qualification.workflowSha256",
    "qualification.artifactArchivePath",
    "qualification.artifactArchiveSha256"
  ],
  "physicalDeviceRequiredFacts": [
    "buildIdentity.signedBuildID",
    "buildIdentity.buildSignatureSha256",
    "device.serialHash",
    "device.osVersion",
    "device.apiLevel",
    "device.buildFingerprint",
    "provider.installedPackageVersion",
    "provider.signingCertificateSha256"
  ],
  "placeholderTokensRejected": [
    "tbd",
    "todo",
    "unknown",
    "placeholder"
  ],
  "policyID": "android-wear-case-evidence-policy-v2",
  "privacyForbiddenKinds": [
    "noteText",
    "transcriptText",
    "audio",
    "filename",
    "userContentPath",
    "uri",
    "documentID",
    "bookmark",
    "coordinate",
    "rawWearPayload"
  ],
  "recordSchema": "../schemas/case-evidence.schema.json",
  "schemaVersion": 2,
  "statusVocabulary": [
    "passed",
    "failed",
    "blocked",
    "notRun",
    "notApplicable"
  ],
  "typedReceiptRequirements": [
    "CORE-001 through CORE-005 require named production-test artifacts before M2 closure can pass.",
    "PERF-003 requires execution provenance and materialization run-set receipts when executed.",
    "PERF-008 requires execution provenance and native package inspection receipts when executed.",
    "Every executed measurement derives its complete numeric samples from its referenced typed receipt.",
    "Hosted qualification rehashes declared external artifacts before they are removed."
  ]
}
