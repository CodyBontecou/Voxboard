    {
      "id": "local-asr-model-package",
      "requiredBeforeMilestone": "M4",
      "reason": "Select the launch model and supported tiers from measured licensing, quality, size, memory, and runtime evidence before M4 starts."
    }
  ],
  "packagingBaselinePolicy": {
    "id": "m2-pre-shared-core-packaging-baseline-v1",
    "required": true,
    "milestone": "M2",
    "method": "Build the planning-parent revision and candidate revision from clean checkouts with the same pinned release toolchain, target matrix, features, stripping, symbols, archive container, and uncompressed-size procedure; record each source commit, toolchain identity, artifact identity, byte count, and artifact SHA-256.",
    "baselineRevision": "b50167aebb959e394908af3a5949f43fa88d6265",
    "requiredIdentityFields": [
      "baselineRevision",
      "candidateRevision",
      "toolchainID",
      "targetScope",
      "buildConfiguration",
      "featureSet",
      "artifactID"
    ],
    "requiredHashFields": [
      "baselineArtifactSha256",
      "candidateArtifactSha256"
    ],
    "growthFormula": "((candidateBytes - baselineBytes) / baselineBytes) * 100",
    "comparisonScope": "Each candidate artifact is compared only with the identically scoped baseline artifact; the maximum scoped growth is evaluated by packaging-growth."
  }
}
