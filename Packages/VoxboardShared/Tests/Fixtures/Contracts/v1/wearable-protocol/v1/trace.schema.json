{
  "$defs": {},
  "$id": "https://vox.md/contracts/wearable-protocol-trace/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "envelopes": {
      "items": {
        "$ref": "../../wearable-protocol/v1/schema.json"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array"
    },
    "expectedDeletionPermitted": {
      "type": "boolean"
    },
    "expectedFinalState": {
      "enum": [
        "phoneIngested",
        "vaultCommitted",
        "terminalFailure",
        "discarded",
        "sourceDeletionAuthorized"
      ]
    },
    "traceID": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "traceVersion": {
      "const": 1
    }
  },
  "required": [
    "traceVersion",
    "traceID",
    "envelopes",
    "expectedFinalState",
    "expectedDeletionPermitted"
  ],
  "title": "wearable-protocol-trace",
  "type": "object"
}
