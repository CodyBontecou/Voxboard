{
  "$defs": {},
  "$id": "https://vox.md/contracts/capture-materialization-input/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "controlByteCount": {
      "maximum": 1048576,
      "minimum": 1,
      "type": "integer"
    },
    "observations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "assets": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "length": {
                  "maximum": 1073741824,
                  "minimum": 0,
                  "type": "integer"
                },
                "mediaType": {
                  "maxLength": 127,
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "sourceID": {
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                  "type": "string"
                }
              },
              "required": [
                "sourceID",
                "mediaType",
                "length",
                "sha256"
              ],
              "type": "object"
            },
            "maxItems": 128,
            "type": "array"
          },
          "kind": {
            "enum": [
              "candidateOccupancy",
              "frozenTemplate",
              "existingNote",
              "stagedAssetMetadata"
            ],
            "type": "string"
          },
          "length": {
            "maximum": 268435456,
            "minimum": 0,
            "type": "integer"
          },
          "logicalPaths": {
            "items": {
              "items": {
                "maxLength": 255,
                "minLength": 1,
                "pattern": "^(?!\\.{1,2}$)(?!.*[\\/\\x00]).+$",
                "type": "string"
              },
              "maxItems": 32,
              "type": "array"
            },
            "maxItems": 256,
            "type": "array"
          },
          "observationID": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "status": {
            "enum": [
              "present",
              "absent"
            ],
            "type": "string"
          }
        },
        "required": [
          "observationID",
          "kind",
          "status"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "type": "array"
    },
    "operation": {
      "enum": [
        "newNote",
        "rollingNote",
        "existingNoteAppend",
        "existingNotePrepend",
        "existingNoteHeading"
      ],
      "type": "string"
    },
    "payloads": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "text",
              "link",
              "asset"
            ],
            "type": "string"
          },
          "length": {
            "maximum": 1073741824,
            "minimum": 0,
            "type": "integer"
          },
          "mediaType": {
            "maxLength": 127,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "sourceID": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "text": {
            "maxLength": 65536,
            "type": "string"
          },
          "url": {
            "maxLength": 8192,
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "preparationRevision": {
      "minimum": 0,
      "type": "integer"
    },
    "presetSnapshotHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "rendererRevision": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "requestID": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "session": {
      "additionalProperties": false,
      "properties": {
        "maximumAggregateObservationBytes": {
          "const": 268435456
        },
        "maximumChunkBytes": {
          "const": 1048576
        }
      },
      "required": [
        "maximumChunkBytes",
        "maximumAggregateObservationBytes"
      ],
      "type": "object"
    },
    "snapshotHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "contractVersion",
    "rendererRevision",
    "requestID",
    "preparationRevision",
    "snapshotHash",
    "controlByteCount",
    "operation",
    "payloads",
    "presetSnapshotHash",
    "observations"
  ],
  "title": "capture-materialization-input",
  "type": "object"
}
