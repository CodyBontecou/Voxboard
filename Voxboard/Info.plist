<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.bontecou.Voxboard</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>voxboard</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Vox.md uses the microphone when you choose to transcribe speech or attach a voice recording to a local Markdown note.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Vox.md uses your location only when you choose to insert a map link into a local Markdown draft.</string>
	<key>NSCameraUsageDescription</key>
	<string>Vox.md uses the camera only when you choose to capture a photo or scan into your local Markdown notes.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Vox.md reads only the photos you choose for a local Markdown capture.</string>
	<key>ONBOARDING_ANALYTICS_ENDPOINT_URL</key>
	<string>https://voxboard-onboarding-analytics.costream.workers.dev</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
