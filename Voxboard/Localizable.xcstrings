{
  "sourceLanguage": "en",
  "strings": {
    "(cleared)": {
      "comment": "Debug log placeholder after user clears the log",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(cleared)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "(очищено)"
          }
        }
      }
    },
    "(empty)": {
      "comment": "Debug log placeholder when the log is empty",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(empty)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "(порожньо)"
          }
        }
      }
    },
    "%dh ago": {
      "comment": "Relative timestamp: N hours ago (e.g. '2h ago')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%dh ago"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%d год тому"
          }
        }
      }
    },
    "%dm %ds": {
      "comment": "Duration: minutes and seconds (e.g. '1m 23s')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%dm %ds"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%dхв %dс"
          }
        }
      }
    },
    "%dm ago": {
      "comment": "Relative timestamp: N minutes ago (e.g. '5m ago')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%dm ago"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%d хв тому"
          }
        }
      }
    },
    "%ds": {
      "comment": "Duration: seconds only (e.g. '42s')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%ds"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%dс"
          }
        }
      }
    },
    "%.1f / 15 MIN FREE": {
      "comment": "Usage meter label: minutes used out of 15 free (e.g. '3.2 / 15 MIN FREE')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f / 15 MIN FREE"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f / 15 ХВ БЕЗКОШТОВНО"
          }
        }
      }
    },
    "%.1f / 15 min free used": {
      "comment": "Settings upgrade section: minutes used out of 15 free (e.g. '3.2 / 15 min free used')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f / 15 min free used"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використано %.1f / 15 безкоштовних хв"
          }
        }
      }
    },
    "%.1f min free remaining.": {
      "comment": "Paywall usage message: minutes remaining on free tier (e.g. '7.3 min free remaining.')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f min free remaining."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишилося %.1f безкоштовних хв."
          }
        }
      }
    },
    "App preferences, upgrade, about, and debug": {
      "comment": "Accessibility hint for the Settings tab",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App preferences, upgrade, about, and debug"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування застосунку, оновлення, про програму та налагодження"
          }
        }
      }
    },
    "Configure automatic transcript file export": {
      "comment": "Accessibility hint for the Files tab",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure automatic transcript file export"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте автоматичний експорт файлів транскрипції"
          }
        }
      }
    },
    "Could not access microphone": {
      "comment": "Error message when microphone permission is denied during recording",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not access microphone"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося отримати доступ до мікрофона"
          }
        }
      }
    },
    "Download and select Whisper or Parakeet AI models": {
      "comment": "Accessibility hint for the Model tab",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download and select Whisper or Parakeet AI models"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажуйте та вибирайте моделі ШІ Whisper або Parakeet"
          }
        }
      }
    },
    "Failed to load model": {
      "comment": "Error message when the AI model fails to initialize",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to load model"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити модель"
          }
        }
      }
    },
    "Free Tier": {
      "comment": "Paywall status badge label for users on the free plan",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free Tier"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безкоштовний план"
          }
        }
      }
    },
    "Limit Reached": {
      "comment": "Paywall status badge label when the user has used all free minutes",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit Reached"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліміт досягнуто"
          }
        }
      }
    },
    "Listening": {
      "comment": "Status badge label when the microphone is active and always-on listening is enabled",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слухає"
          }
        }
      }
    },
    "Mic unavailable": {
      "comment": "IPC error message when the microphone cannot be accessed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mic unavailable"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікрофон недоступний"
          }
        }
      }
    },
    "Model load failed": {
      "comment": "IPC error response when the AI model fails to load",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model load failed"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити модель"
          }
        }
      }
    },
    "Model not found": {
      "comment": "IPC error response when the requested AI model cannot be found on disk",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model not found"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель не знайдено"
          }
        }
      }
    },
    "Model not found: %@": {
      "comment": "Error message with model ID when the AI model file does not exist (e.g. 'Model not found: whisper-base')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model not found: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель не знайдено: %@"
          }
        }
      }
    },
    "No audio captured": {
      "comment": "IPC error response when recording produced no audio data",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No audio captured"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіо не записано"
          }
        }
      }
    },
    "No audio was captured": {
      "comment": "User-facing error message when the recording ended with no audio",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No audio was captured"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіо не було записано"
          }
        }
      }
    },
    "No speech detected": {
      "comment": "Error message when transcription finds no recognisable speech in the audio",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No speech detected"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мовлення не виявлено"
          }
        }
      }
    },
    "Not set": {
      "comment": "Placeholder shown in the file export folder picker when no folder has been chosen",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not set"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не встановлено"
          }
        }
      }
    },
    "Off": {
      "comment": "Status badge label when always-on listening is disabled",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнено"
          }
        }
      }
    },
    "Opens an email draft to contact support with app diagnostics": {
      "comment": "Accessibility hint for the Send Feedback button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens an email draft to contact support with app diagnostics"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває чернетку листа для зв’язку з підтримкою з діагностикою застосунку"
          }
        }
      }
    },
    "Record and transcribe audio in real time": {
      "comment": "Accessibility hint for the Listen tab",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record and transcribe audio in real time"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записуйте й транскрибуйте аудіо в реальному часі"
          }
        }
      }
    },
    "Send Feedback": {
      "comment": "Accessibility label for the Send Feedback button in Settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send Feedback"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надіслати відгук"
          }
        }
      }
    },
    "Something went wrong": {
      "comment": "Fallback error message shown in the recording flow when no specific error is available",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щось пішло не так"
          }
        }
      }
    },
    "TRANSCRIBING": {
      "comment": "Base text for the animated transcribing indicator (dots are appended programmatically)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TRANSCRIBING"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ТРАНСКРИБУВАННЯ"
          }
        }
      }
    },
    "Unlimited": {
      "comment": "Paywall status badge label for users who have purchased unlimited access",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlimited"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безліміт"
          }
        }
      }
    },
    "Unlimited is already unlocked on this device.": {
      "comment": "Paywall usage message for users who have already purchased",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlimited is already unlocked on this device."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безліміт уже розблоковано на цьому пристрої."
          }
        }
      }
    },
    "You've used all your free transcription time.": {
      "comment": "Paywall usage message when the free tier limit has been reached",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've used all your free transcription time."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви використали весь безкоштовний час транскрипції."
          }
        }
      }
    },
    "just now": {
      "comment": "Relative timestamp for events less than 60 seconds ago",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "just now"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "щойно"
          }
        }
