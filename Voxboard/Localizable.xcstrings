{
  "sourceLanguage": "en",
  "strings": {
    "(cleared)": {
      "comment": "Debug log placeholder after user clears the log",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(cleared)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "（已清除）"
          }
        }
      }
    },
    "(empty)": {
      "comment": "Debug log placeholder when the log is empty",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(empty)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "（空）"
          }
        }
      }
    },
    "%dh ago": {
      "comment": "Relative timestamp: N hours ago (e.g. '2h ago')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%dh ago"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%d小時前"
          }
        }
      }
    },
    "%dm %ds": {
      "comment": "Duration: minutes and seconds (e.g. '1m 23s')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%dm %ds"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%d分%d秒"
          }
        }
      }
    },
    "%dm ago": {
      "comment": "Relative timestamp: N minutes ago (e.g. '5m ago')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%dm ago"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%d分鐘前"
          }
        }
      }
    },
    "%ds": {
      "comment": "Duration: seconds only (e.g. '42s')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%ds"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%d秒"
          }
        }
      }
    },
    "%.1f / 15 MIN FREE": {
      "comment": "Usage meter label: minutes used out of 15 free (e.g. '3.2 / 15 MIN FREE')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f / 15 MIN FREE"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f / 15 分鐘免費"
          }
        }
      }
    },
    "%.1f / 15 min free used": {
      "comment": "Settings upgrade section: minutes used out of 15 free (e.g. '3.2 / 15 min free used')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f / 15 min free used"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已使用 %.1f / 15 分鐘免費時間"
          }
        }
      }
    },
    "%.1f min free remaining.": {
      "comment": "Paywall usage message: minutes remaining on free tier (e.g. '7.3 min free remaining.')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f min free remaining."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剩餘 %.1f 分鐘免費時間。"
          }
        }
      }
    },
    "App preferences, upgrade, about, and debug": {
      "comment": "Accessibility hint for the Settings tab",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App preferences, upgrade, about, and debug"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式偏好設定、升級、關於及除錯"
          }
        }
      }
    },
    "Configure automatic transcript file export": {
      "comment": "Accessibility hint for the Files tab",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure automatic transcript file export"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定自動匯出轉錄檔案"
          }
        }
      }
    },
    "Could not access microphone": {
      "comment": "Error message when microphone permission is denied during recording",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not access microphone"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法存取麥克風"
          }
        }
      }
    },
    "Download and select Whisper or Parakeet AI models": {
      "comment": "Accessibility hint for the Model tab",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download and select Whisper or Parakeet AI models"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載並選擇 Whisper 或 Parakeet AI 模型"
          }
        }
      }
    },
    "Failed to load model": {
      "comment": "Error message when the AI model fails to initialize",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to load model"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型載入失敗"
          }
        }
      }
    },
    "Free Tier": {
      "comment": "Paywall status badge label for users on the free plan",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free Tier"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費方案"
          }
        }
      }
    },
    "Limit Reached": {
      "comment": "Paywall status badge label when the user has used all free minutes",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit Reached"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已達上限"
          }
        }
      }
    },
    "Listening": {
      "comment": "Status badge label when the microphone is active and always-on listening is enabled",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聆聽中"
          }
        }
      }
    },
    "Mic unavailable": {
      "comment": "IPC error message when the microphone cannot be accessed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mic unavailable"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風無法使用"
          }
        }
      }
    },
    "Model load failed": {
      "comment": "IPC error response when the AI model fails to load",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model load failed"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型載入失敗"
          }
        }
      }
    },
    "Model not found": {
      "comment": "IPC error response when the requested AI model cannot be found on disk",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model not found"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到模型"
          }
        }
      }
    },
    "Model not found: %@": {
      "comment": "Error message with model ID when the AI model file does not exist (e.g. 'Model not found: whisper-base')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model not found: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到模型：%@"
          }
        }
      }
    },
    "No audio captured": {
      "comment": "IPC error response when recording produced no audio data",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No audio captured"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未擷取到音訊"
          }
        }
      }
    },
    "No audio was captured": {
      "comment": "User-facing error message when the recording ended with no audio",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No audio was captured"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未擷取到音訊"
          }
        }
      }
    },
    "No speech detected": {
      "comment": "Error message when transcription finds no recognisable speech in the audio",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No speech detected"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未偵測到語音"
          }
        }
      }
    },
    "Not set": {
      "comment": "Placeholder shown in the file export folder picker when no folder has been chosen",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not set"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定"
          }
        }
      }
    },
    "Off": {
      "comment": "Status badge label when always-on listening is disabled",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉"
          }
        }
      }
    },
    "Opens an email draft to contact support with app diagnostics": {
      "comment": "Accessibility hint for the Send Feedback button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens an email draft to contact support with app diagnostics"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟電子郵件草稿以附上應用程式診斷資訊聯繫支援團隊"
          }
        }
      }
    },
    "Record and transcribe audio in real time": {
      "comment": "Accessibility hint for the Listen tab",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record and transcribe audio in real time"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時錄製並轉錄音訊"
          }
        }
      }
    },
    "Send Feedback": {
      "comment": "Accessibility label for the Send Feedback button in Settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send Feedback"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送意見回饋"
          }
        }
      }
    },
    "Something went wrong": {
      "comment": "Fallback error message shown in the recording flow when no specific error is available",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發生錯誤"
          }
        }
      }
    },
    "TRANSCRIBING": {
      "comment": "Base text for the animated transcribing indicator (dots are appended programmatically)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TRANSCRIBING"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉錄中"
          }
        }
      }
    },
    "Unlimited": {
      "comment": "Paywall status badge label for users who have purchased unlimited access",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlimited"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無限制"
          }
        }
      }
    },
    "Unlimited is already unlocked on this device.": {
      "comment": "Paywall usage message for users who have already purchased",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlimited is already unlocked on this device."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置已解鎖無限制版。"
          }
        }
      }
    },
    "You've used all your free transcription time.": {
      "comment": "Paywall usage message when the free tier limit has been reached",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've used all your free transcription time."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您已用完所有免費轉錄時間。"
          }
        }
      }
    },
    "just now": {
      "comment": "Relative timestamp for events less than 60 seconds ago",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "just now"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剛剛"
          }
        }
      }
    }
  },
  "version": "1.0"
}
