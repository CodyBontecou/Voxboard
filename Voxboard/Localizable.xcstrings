        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free Tier"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخطة المجانية"
          }
        }
      }
    },
    "Limit Reached": {
      "comment": "Paywall status badge label when the user has used all free minutes",
