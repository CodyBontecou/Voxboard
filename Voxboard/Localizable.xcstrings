      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model not found"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy mô hình"
          }
        }
      }
    },
    "Model not found: %@": {
      "comment": "Error message with model ID when the AI model file does not exist (e.g. 'Model not found: whisper-base')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model not found: %@"
