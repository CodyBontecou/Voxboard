    "%.1f / 15 MIN FREE": {
      "comment": "Usage meter label: minutes used out of 15 free (e.g. '3.2 / 15 MIN FREE')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f / 15 MIN FREE"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f / 15 دقيقة مجانية"
          }
        }
      }
    },
    "%.1f / 15 min free used": {
      "comment": "Settings upgrade section: minutes used out of 15 free (e.g. '3.2 / 15 min free used')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f / 15 min free used"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم استخدام %.1f / 15 دقيقة مجانية"
          }
        }
      }
    },
    "%.1f min free remaining.": {
      "comment": "Paywall usage message: minutes remaining on free tier (e.g. '7.3 min free remaining.')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f min free remaining."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متبقٍ %.1f دقيقة مجانية."
          }
        }
      }
    },
    "App preferences, upgrade, about, and debug": {
      "comment": "Accessibility hint for the Settings tab",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App preferences, upgrade, about, and debug"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفضيلات التطبيق، الترقية، حول، وتصحيح الأخطاء"
          }
        }
      }
    },
    "Configure automatic transcript file export": {
      "comment": "Accessibility hint for the Files tab",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure automatic transcript file export"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعداد التصدير التلقائي لملف التفريغ"
          }
        }
      }
    },
    "Could not access microphone": {
      "comment": "Error message when microphone permission is denied during recording",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not access microphone"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الوصول إلى الميكروفون"
          }
        }
      }
    },
    "Download and select Whisper or Parakeet AI models": {
      "comment": "Accessibility hint for the Model tab",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download and select Whisper or Parakeet AI models"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نزّل واختر نماذج الذكاء الاصطناعي Whisper أو Parakeet"
          }
        }
      }
    },
    "Failed to load model": {
      "comment": "Error message when the AI model fails to initialize",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to load model"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل تحميل النموذج"
          }
        }
      }
    },
    "Free Tier": {
      "comment": "Paywall status badge label for users on the free plan",
