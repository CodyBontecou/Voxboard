      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No speech detected"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم اكتشاف كلام"
          }
        }
      }
    },
    "Not set": {
