      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not access microphone"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể truy cập micro"
          }
        }
      }
    },
