      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang nghe"
          }
        }
      }
    },
    "Mic unavailable": {
      "comment": "IPC error message when the microphone cannot be accessed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mic unavailable"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Micro không khả dụng"
          }
        }
      }
    },
    "Model load failed": {
      "comment": "IPC error response when the AI model fails to load",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model load failed"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải mô hình thất bại"
          }
        }
      }
    },
    "Model not found": {
      "comment": "IPC error response when the requested AI model cannot be found on disk",
