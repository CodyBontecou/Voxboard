          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمع"
          }
        }
      }
    },
    "Mic unavailable": {
      "comment": "IPC error message when the microphone cannot be accessed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mic unavailable"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الميكروفون غير متاح"
          }
        }
      }
    },
    "Model load failed": {
      "comment": "IPC error response when the AI model fails to load",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model load failed"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل تحميل النموذج"
          }
        }
      }
    },
    "Model not found": {
      "comment": "IPC error response when the requested AI model cannot be found on disk",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model not found"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على النموذج"
          }
        }
      }
    },
    "Model not found: %@": {
      "comment": "Error message with model ID when the AI model file does not exist (e.g. 'Model not found: whisper-base')",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model not found: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على النموذج: %@"
          }
        }
      }
    },
    "No audio captured": {
      "comment": "IPC error response when recording produced no audio data",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No audio captured"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم التقاط أي صوت"
          }
        }
      }
    },
    "No audio was captured": {
      "comment": "User-facing error message when the recording ended with no audio",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No audio was captured"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم التقاط أي صوت"
          }
        }
      }
    },
    "No speech detected": {
      "comment": "Error message when transcription finds no recognisable speech in the audio",
