          "stringUnit": {
            "state": "translated",
            "value": "Tải xuống và chọn mô hình AI Whisper hoặc Parakeet"
          }
        }
      }
    },
    "Failed to load model": {
      "comment": "Error message when the AI model fails to initialize",
