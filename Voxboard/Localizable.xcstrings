          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الوصول إلى الحد"
          }
        }
      }
    },
    "Listening": {
      "comment": "Status badge label when the microphone is active and always-on listening is enabled",
