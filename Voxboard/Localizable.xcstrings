      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not set"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير محدد"
          }
        }
      }
    },
    "Off": {
      "comment": "Status badge label when always-on listening is disabled",
