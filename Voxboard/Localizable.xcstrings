      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No audio captured"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thu được âm thanh"
          }
        }
      }
    },
