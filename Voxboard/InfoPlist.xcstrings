    "NSSpeechRecognitionUsageDescription": {
      "comment": "Privacy prompt explaining speech recognition.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md يستخدم Apple Speech لتسجيل تسجيلك المحلي أثناء الكلام."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ব্যবহার Apple Speech আপনি কথা বলার সময় আপনার রেকর্ডটি স্থানীয়ভাবে ট্রান্সক্রিপ্ট করতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md benutzt Apple Speech Um Ihre Aufzeichnung lokal zu transkribieren, während Sie sprechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md uses Apple Speech to transcribe your recording locally while you speak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Uso Apple Speech para transcribir su grabación localmente mientras habla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Utilisé Apple Speech pour transcrire votre enregistrement localement pendant que vous parlez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md उपयोग करें Apple Speech अपने रिकॉर्ड को स्थानीय रूप से ट्रांसक्रिप्शन करने के लिए जब आप बोलते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Menggunakan Apple Speech untuk mencatat rekaman Anda secara lokal saat Anda berbicara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md utilizzo Apple Speech per trascrivere la registrazione localmente mentre si parla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 利用 Apple Speech 話す間、録音を地元で書き換える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 사용하기 Apple Speech 당신이 말하는 동안 로컬로 녹음하기 위해."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Gebruik Apple Speech om uw opname lokaal te transcriberen terwijl u spreekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Używaj Apple Speech aby transkrybować nagranie lokalnie podczas mówienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Usar Apple Speech para transcrever a sua gravação localmente enquanto fala."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md использует Apple Speech для транскрипции записи локально, пока вы говорите."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md பயன்படுத்த Apple Speech உங்கள் பேச்சைப் பற்றி எழுதுவதற்காகவே, நீங்கள் பேசும் போது உங்கள் பதிவுகளை இடையில் எழுதிக் கொள்ளுங்கள்."
          }
