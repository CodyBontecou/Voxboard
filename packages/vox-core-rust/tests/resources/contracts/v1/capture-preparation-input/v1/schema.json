{
  "$defs": {},
  "$id": "https://vox.md/contracts/capture-preparation-input/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "calendar": {
      "const": "gregorian"
    },
    "captureSource": {
      "enum": [
        "app",
        "share",
        "keyboard",
        "widget",
        "shortcut",
        "watch",
        "wear"
      ],
      "type": "string"
    },
    "contractVersion": {
      "const": 1
    },
    "createdAt": {
      "maximum": 4102444800000,
      "minimum": 0,
      "type": "integer"
    },
    "operation": {
      "enum": [
        "newNote",
        "rollingNote",
        "existingNoteAppend",
        "existingNotePrepend",
        "existingNoteHeading"
      ],
      "type": "string"
    },
    "payloads": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "text",
              "link",
              "asset"
            ],
            "type": "string"
          },
          "length": {
            "maximum": 1073741824,
            "minimum": 0,
            "type": "integer"
          },
          "mediaType": {
            "maxLength": 127,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "sourceID": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "text": {
            "maxLength": 65536,
            "type": "string"
          },
          "url": {
            "maxLength": 8192,
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "preset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "retryMarkerPolicy": {
          "enum": [
            "none",
            "voxCaptureCommentV1"
          ],
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "type": "integer"
        },
        "snapshotHash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "templateFreezePoint": {
          "const": "firstPreparation"
        }
      },
      "required": [
        "id",
        "revision",
        "snapshotHash",
        "templateFreezePoint",
        "retryMarkerPolicy"
      ],
      "type": "object"
    },
    "requestID": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "routePolicy": {
      "additionalProperties": false,
      "properties": {
        "collisionPolicy": {
          "enum": [
            "fail",
            "reuseIfHashMatches",
            "deterministicSuffix"
          ],
          "type": "string"
        },
        "logicalFolder": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)(?!.*[\\/\\x00]).+$",
            "type": "string"
          },
          "maxItems": 32,
          "type": "array"
        }
      },
      "required": [
        "logicalFolder",
        "collisionPolicy"
      ],
      "type": "object"
    },
    "timezone": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "contractVersion",
    "requestID",
    "captureSource",
    "createdAt",
    "timezone",
    "calendar",
    "operation",
    "payloads",
    "preset",
    "routePolicy"
  ],
  "title": "capture-preparation-input",
  "type": "object"
}
