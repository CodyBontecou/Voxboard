{
  "$defs": {},
  "$id": "https://vox.md/contracts/artifact-plan/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifactID": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "commitSequence": {
            "maximum": 128,
            "minimum": 0,
            "type": "integer"
          },
          "expectedExisting": {
            "enum": [
              "absent",
              "hashMatch",
              "any"
            ],
            "type": "string"
          },
          "expectedOriginalHash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "journalFrontier": {
            "enum": [
              "prepared",
              "attachmentVerified",
              "noteVerified"
            ],
            "type": "string"
          },
          "kind": {
            "enum": [
              "note",
              "attachment"
            ],
            "type": "string"
          },
          "length": {
            "maximum": 1073741824,
            "minimum": 0,
            "type": "integer"
          },
          "logicalPath": {
            "items": {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^(?!\\.{1,2}$)(?!.*[\\/\\x00]).+$",
              "type": "string"
            },
            "maxItems": 32,
            "minItems": 1,
            "type": "array"
          },
          "mediaType": {
            "maxLength": 127,
            "type": "string"
          },
          "operationID": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "receiptKind": {
            "enum": [
              "attachmentCommit",
              "noteCommit"
            ],
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "sourceID": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          }
        },
        "required": [
          "artifactID",
          "operationID",
          "kind",
          "mediaType",
          "length",
          "sha256",
          "commitSequence",
          "journalFrontier",
          "receiptKind"
        ],
        "type": "object"
      },
      "maxItems": 129,
      "minItems": 1,
      "type": "array"
    },
    "contractVersion": {
      "const": 1
    },
    "operation": {
      "enum": [
        "newNote",
        "rollingNote",
        "existingNoteAppend",
        "existingNotePrepend",
        "existingNoteHeading"
      ],
      "type": "string"
    },
    "planHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "preparedByteDelivery": {
      "additionalProperties": false,
      "properties": {
        "finalJSONDuplicatesBytes": {
          "const": false
        },
        "maximumChunkBytes": {
          "const": 1048576
        },
        "mode": {
          "const": "drainedImmutableArtifacts"
        }
      },
      "required": [
        "mode",
        "maximumChunkBytes",
        "finalJSONDuplicatesBytes"
      ],
      "type": "object"
    },
    "rendererRevision": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "requestID": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "retryMarker": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "enum": [
            "none",
            "voxCaptureCommentV1"
          ],
          "type": "string"
        },
        "syntax": {
          "maxLength": 128,
          "type": "string"
        }
      },
      "required": [
        "policy",
        "syntax"
      ],
      "type": "object"
    },
    "warnings": {
      "items": {
        "maxLength": 128,
        "type": "string"
      },
      "maxItems": 64,
      "type": "array"
    }
  },
  "required": [
    "contractVersion",
    "requestID",
    "rendererRevision",
    "planHash",
    "operation",
    "retryMarker",
    "artifacts",
    "preparedByteDelivery"
  ],
  "title": "artifact-plan",
  "type": "object"
}
