{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vox.md/contracts/schemas/case-evidence-requirements.schema.json",
  "type": "object",
  "required": ["$schema", "schemaVersion", "policyID", "recordSchema", "statusVocabulary", "requiredCampaignFacts", "placeholderTokensRejected", "privacyForbiddenKinds"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "../schemas/case-evidence-requirements.schema.json"},
    "schemaVersion": {"const": 1},
    "policyID": {"type": "string", "minLength": 1},
    "recordSchema": {"const": "../schemas/case-evidence.schema.json"},
    "statusVocabulary": {"const": ["passed", "failed", "blocked", "notRun", "notApplicable"]},
    "requiredCampaignFacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "placeholderTokensRejected": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "privacyForbiddenKinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
