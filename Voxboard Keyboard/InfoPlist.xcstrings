    "NSMicrophoneUsageDescription": {
      "comment": "Privacy prompt explaining microphone access from the keyboard extension.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md يحتاج إلى الوصول إلى ميكروفون لتتبع صوتك إلى النص."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md আপনার কণ্ঠকে পাঠ্যতে ট্রান্সক্রিপ্ট করতে মাইক্রোফোন অ্যাক্সেস প্রয়োজন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Sie benötigen einen Mikrofonzugang, um Ihre Stimme in Text zu transkribieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md needs microphone access to transcribe your voice into text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Necesita acceso al micrófono para transcribir su voz en texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Vous avez besoin d’un micro pour transcrire votre voix en texte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md आपको अपनी आवाज को पाठ में ट्रांसक्रिप्शन करने के लिए माइक्रोफोन पहुंच की आवश्यकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md membutuhkan akses mikrofon untuk mencatat suara Anda menjadi teks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Hai bisogno di un microfono per trascrivere la tua voce in testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md マイクにアクセスして、声をテキストに翻訳する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 마이크에 접근하여 목소리를 텍스트로 번역해야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Je hebt toegang tot de microfoon nodig om je stem in tekst te transcriberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Potrzebujesz dostępu do mikrofonu, aby przetłumaczyć głos na tekst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Necessita de acesso ao microfone para transcrever a sua voz em texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Вам нужен доступ к микрофону для транскрипции вашего голоса в текст."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md உங்கள் பேச்சை Text-ல் Transcribe செய்ய மைக்ரோஃபன் அணுக வேண்டும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ต้องการเข้าถึงไมโครโฟนเพื่อถ่ายโอนเสียงลงในข้อความ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Sesinizi metin olarak transcribe etmek için mikrofon erişimi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Вам потрібен доступ до мікрофона, щоб переписати голос у текст."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md آپ کی آواز کو متن میں ٹرانسفر کرنے کے لئے مائیکروفون تک رسائی کی ضرورت ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md cần truy cập micro để chuyển giọng nói của bạn thành văn bản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 需要麦克风访问才能将您的声音转录成文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 需要麥克風訪問才能將您的聲音轉錄成文本。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
