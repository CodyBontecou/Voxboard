{
  "$defs": {},
  "$id": "https://vox.md/contracts/wearable-protocol/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlationID": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "deviceID": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "epoch": {
      "minimum": 0,
      "type": "integer"
    },
    "messageID": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "messageKind": {
      "enum": [
        "capabilityHello",
        "unsupportedVersion",
        "presetInventory",
        "recordingMetadata",
        "assetManifest",
        "transferFrontier",
        "reconciliationSummary",
        "transferReceipt",
        "phoneIngested",
        "vaultCommitted",
        "terminalFailure",
        "discarded",
        "sourceDeletionAuthorized",
        "reassign",
        "retry",
        "discard"
      ],
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "maxProperties": 32,
      "properties": {
        "action": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "assetLength": {
          "maximum": 1073741824,
          "minimum": 0,
          "type": "integer"
        },
        "assetSHA256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "authorizationThreshold": {
          "enum": [
            "vaultCommitted"
          ],
          "type": "string"
        },
        "chunkLength": {
          "maximum": 1073741824,
          "minimum": 0,
          "type": "integer"
        },
        "chunkSequence": {
          "maximum": 1073741824,
          "minimum": 0,
          "type": "integer"
        },
        "durableOffset": {
          "maximum": 1073741824,
          "minimum": 0,
          "type": "integer"
        },
        "frontierRevision": {
          "minimum": 0,
          "type": "integer"
        },
        "localASRPolicy": {
          "enum": [
            "requiredLocal",
            "optionalLocal",
            "disabled"
          ],
          "type": "string"
        },
        "locationPolicy": {
          "enum": [
            "excluded",
            "coordinateOnly",
            "exact",
            "city"
          ],
          "type": "string"
        },
        "mode": {
          "enum": [
            "transcript",
            "recordingOnly"
          ],
          "type": "string"
        },
        "phonePackageHash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "presetIDs": {
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "presetSnapshotHash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "reasonCode": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "recordingIDs": {
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "recordingOnlyPolicyReference": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "supportedVersions": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 16,
          "type": "array"
        },
        "targetCapabilityReference": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "vaultCommitCorrelationID": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "verifiedArtifactHash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "protocolVersion": {
      "const": 1
    },
    "recordingID": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "replayRule": {
      "enum": [
        "idempotent",
        "newerRevisionWins",
        "terminal"
      ],
      "type": "string"
    },
    "revision": {
      "minimum": 0,
      "type": "integer"
    },
    "senderInstallationID": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "required": [
    "protocolVersion",
    "messageKind",
    "messageID",
    "recordingID",
    "senderInstallationID",
    "deviceID",
    "epoch",
    "revision",
    "correlationID",
    "replayRule",
    "payload"
  ],
  "title": "wearable-protocol",
  "type": "object"
}
