{
  "$id": "https://vox.md/contracts/wearable-protocol-trace/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wearable-protocol-trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["traceVersion", "traceID", "events", "expectedFinalRecordingIdentity", "expectedFinalState", "expectedDeletionPermitted"],
  "properties": {
    "traceVersion": {"const": 1},
    "traceID": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["envelope", "expectedDisposition"],
        "properties": {
          "envelope": {"$ref": "../../wearable-protocol/v1/schema.json"},
          "expectedDisposition": {"enum": ["accepted", "duplicateNoOp", "staleRevisionNoOp", "staleEpochNoOp", "foreignInstallationRejected"]}
        }
      }
    },
    "expectedFinalRecordingIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["senderInstallationID", "deviceID", "recordingID", "epoch", "correlationID"],
      "properties": {
        "senderInstallationID": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "deviceID": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "recordingID": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "epoch": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "correlationID": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
      }
    },
    "expectedFinalState": {"enum": ["none", "reconciled", "capabilityHello", "unsupportedVersion", "presetInventory", "presetSnapshot", "recordingMetadata", "assetManifest", "transferFrontier", "transferReceipt", "phoneIngested", "vaultCommitted", "terminalFailure", "discarded", "sourceDeletionAuthorized", "reassign", "retry", "discard", "reconciliationSummary"]},
    "expectedDeletionPermitted": {"type": "boolean"}
  }
}
